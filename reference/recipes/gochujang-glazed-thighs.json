{
  "id": "gochujang-glazed-thighs",
  "name": "Gochujang-Glazed Thighs",
  "vibe": "sticky, sweet-hot, a little funky — bone-in thighs lacquered until the glaze catches at the edges.",
  "serves": 4,
  "time": { "activeMin": 15, "totalMin": 45 },
  "flavor": "asian",
  "tags": ["oven", "adventurous", "batch", "sticky"],
  "season": [],
  "cut": "thigh-bonein",
  "ingredients": [
    { "item": "chicken-thighs-bone-in-skin-on", "display": "bone-in, skin-on thighs", "qty": "6", "group": "Protein", "required": true, "depletes": "heavy" },
    { "item": "gochujang", "display": "gochujang", "qty": "3 tbsp", "group": "Sauce", "star": true, "required": true, "depletes": "heavy" },
    { "item": "honey", "display": "honey", "qty": "2 tbsp", "group": "Sauce", "required": true, "depletes": "some" },
    { "item": "soy-sauce", "display": "soy sauce", "qty": "1 tbsp", "group": "Sauce", "required": true, "depletes": "light" },
    { "item": "garlic", "display": "garlic", "qty": "3 cloves, grated", "group": "Sauce", "required": true, "depletes": "light" },
    { "item": "ginger-fresh", "display": "ginger", "qty": "1 thumb, grated", "group": "Sauce", "required": true, "depletes": "some" },
    { "item": "rice-jasmine", "display": "jasmine rice", "qty": "for serving", "group": "Starch", "required": true, "depletes": "some" },
    { "item": "spring-onions-cebollita", "display": "spring onions", "qty": "2, sliced", "group": "Veg & Aromatics", "required": false, "depletes": "some" },
    { "item": "sesame-seeds", "display": "toasted sesame", "qty": "to finish", "group": "Pantry & Spices", "required": false, "depletes": "light" }
  ],
  "steps": [
    { "n": 1, "text": "Heat oven to 220°C / 425°F. Whisk gochujang, honey, soy, garlic and ginger into a glaze.", "glyph": "oven", "timerSec": 0, "uses": ["gochujang", "honey", "soy-sauce", "garlic", "ginger-fresh"] },
    { "n": 2, "text": "Pat the thighs dry, salt them, and toss in half the glaze. Skin-side up on a lined tray.", "glyph": "knife", "timerSec": 0, "uses": ["chicken-thighs-bone-in-skin-on"] },
    { "n": 3, "text": "Roast 25 minutes until the skin renders and starts to color.", "glyph": "oven", "timerSec": 1500, "uses": [] },
    { "n": 4, "text": "Brush on the rest of the glaze; roast 8–10 more until sticky and caught at the edges.", "glyph": "oven", "timerSec": 540, "uses": ["gochujang"] },
    { "n": 5, "text": "Meanwhile, steam the jasmine rice.", "glyph": "pot", "timerSec": 720, "uses": ["rice-jasmine"] },
    { "n": 6, "text": "Rest 5 minutes; scatter spring onions and toasted sesame over the top.", "glyph": "bowl", "timerSec": 0, "uses": ["spring-onions-cebollita", "sesame-seeds"] }
  ],
  "finish": "Serve over the rice with the tray juices spooned on. A cold, sharp cucumber salad cuts the sweetness.",
  "notes": [
    "No gochujang? A mix of miso + sriracha + a pinch of sugar gets you in the neighborhood.",
    "Doubles easily and the leftovers shred into rice bowls or tacos — the glaze reheats beautifully.",
    "Big draw on the gochujang and thighs — the checklist will offer to mark them down."
  ]
}
