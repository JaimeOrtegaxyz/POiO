{
  "name": "poio-mockup",
  "version": "0.1.0",
  "private": true,
  "description": "POiO online mockup: a public landing, invite-only browser profiles, and a browser emulation of the device (color e-paper screen in the frontal render's face, red star knob that turns, presses and holds to talk, back and home pills) driven by a small brain proxy.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c yellow,red \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch server/index.ts",
    "dev:web": "vite",
    "build": "tsc --noEmit && vite build && node scripts/copy-brain.mjs",
    "start": "npm run build && POIO_STATIC_DIR=dist POIO_BRAIN_DIR=dist/brain tsx server/index.ts",
    "serve": "POIO_STATIC_DIR=dist POIO_BRAIN_DIR=dist/brain tsx server/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "invites": "tsx server/cli/invites.ts",
    "feedback": "tsx server/cli/feedback.ts",
    "face": "python3 -I scripts/face/build-face.py"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.5.0",
    "@hono/node-server": "^2.1.6",
    "@jaimeortega/vaiven": "^0.1.2",
    "ajv": "^8.20.0",
    "hono": "^4.13.16",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "concurrently": "^10.0.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
