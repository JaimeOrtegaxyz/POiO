    { "item": "chile-guajillo", "display": "chiles guajillo", "qty": "2, sin semillas", "group": "Pantry & Spices", "star": true, "required": true, "depletes": "some" },
    { "item": "white-vinegar", "display": "vinagre blanco", "qty": "2 cucharadas (30 ml)", "group": "Pantry & Spices", "required": true, "depletes": "light" },
    { "item": "oregano-mexican", "display": "orégano", "qty": "1 cucharadita", "group": "Pantry & Spices", "required": true, "depletes": "light" },
    { "item": "garlic", "display": "ajo", "qty": "2 dientes", "group": "Veg & Aromatics", "required": true, "depletes": "light" },
    { "item": "salt-kosher-table", "display": "sal", "qty": "al gusto", "group": "Pantry & Spices", "required": true, "depletes": "none" },
    { "item": "vegetable-oil", "display": "aceite", "qty": "1 cucharada (15 ml)", "group": "Pantry & Spices", "required": true, "depletes": "light" },
    { "item": "pineapple", "display": "piña", "qty": "2 rodajas", "group": "Veg & Aromatics", "required": false, "depletes": "finishes" },
    { "item": "corn-tortillas", "display": "tortillas de maíz", "qty": "8", "group": "Starch", "required": true, "depletes": "heavy" },
    { "item": "white-onion", "display": "cebolla blanca", "qty": "¼, picada", "group": "Veg & Aromatics", "required": true, "depletes": "some" },
    { "item": "cilantro", "display": "cilantro", "qty": "picado", "group": "Veg & Aromatics", "required": false, "depletes": "some" },
    { "item": "limes", "display": "limón", "qty": "1, en cuartos", "group": "Pantry & Spices", "required": false, "depletes": "light" }
  ],
  "steps": [
    { "n": 1, "text": "Remoja los guajillos en agua caliente. A los 10 min, checkpoint: están suaves.", "glyph": "bowl", "checkpoint": { "afterSec": 600, "message": "Los guajillos ya deben estar suaves." }, "uses": ["chile-guajillo"] },
    { "n": 2, "text": "Licúa los guajillos con el ajo, el vinagre, el orégano y sal. Baña el pollo con el adobo.", "glyph": "bowl", "uses": ["chile-guajillo", "garlic", "white-vinegar", "oregano-mexican", "salt-kosher-table"] },
    { "n": 3, "text": "Dora el pollo en el aceite, a fuego alto, sin moverlo mucho. A los 6 min, checkpoint: tostado en las orillas.", "glyph": "pan", "checkpoint": { "afterSec": 360, "message": "Revisa que esté tostado en las orillas." }, "uses": ["chicken-thighs-boneless", "vegetable-oil"] },
    { "n": 4, "text": "Dora la piña en la misma sartén y pícala.", "glyph": "pan", "uses": ["pineapple"] },
    { "n": 5, "text": "Calienta las tortillas y arma: pollo, piña, cebolla, cilantro y limón.", "glyph": "griddle", "uses": ["corn-tortillas", "white-onion", "cilantro", "limes"] }
  ],
  "finish": "Una salsa verde cruda o de chile de árbol les queda muy bien.",
  "notes": [
    "¿No hay guajillo? Chile ancho remojado da un adobo más dulce.",
    "El adobo se puede hacer desde la mañana; el pollo agarra más sabor."
  ]
}
