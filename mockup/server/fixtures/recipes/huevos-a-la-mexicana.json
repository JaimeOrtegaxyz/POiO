    { "n": 4, "text": "Retira del fuego cuando todavía se vean un poco húmedos.", "glyph": "pan", "uses": [] },
    { "n": 5, "text": "Sirve con tortillas calientes.", "glyph": "griddle", "uses": ["corn-tortillas"] }
