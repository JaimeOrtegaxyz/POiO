  "steps": [
    { "n": 1, "text": "Calienta el aceite a fuego medio y sofríe la cebolla y el chile. A los 3 min, checkpoint: la cebolla transparente.", "glyph": "pan", "checkpoint": { "afterSec": 180, "message": "La cebolla ya debe verse transparente." }, "uses": ["vegetable-oil", "white-onion", "serranos"] },
